---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import wordmarkFont from "@fontsource/grenze-gotisch/files/grenze-gotisch-latin-900-normal.woff2?url";
import sansFont from "@fontsource/arimo/files/arimo-latin-700-normal.woff2?url";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../site.config";
import { getCurrentSeason, seasonStyle } from "../lib/seasons";

interface Props {
  title?: string;
  description?: string;
  /** Home renders the line under the name as the page's h1. */
  isHome?: boolean;
}

const { title, description = site.description, isHome = false } = Astro.props;
const season = await getCurrentSeason();
const pageTitle = title ? `${title} / ${site.name}` : `${site.name}, backend engineer and creative builder`;
const year = new Date().getFullYear();
const shareImage = new URL("/share.jpg", Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en" data-type="service" style={seasonStyle(season)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="page-type" content="service" />
    <meta name="site-kind" content="other" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={wordmarkFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={sansFont} crossorigin />
    <!-- Hero entrance and the photo-develop moment (taste-skill's motion contract). -->
    <script is:inline>
      document.documentElement.classList.add("m-enter", "mo-js");
      setTimeout(function () { document.documentElement.classList.add("m-enter-done"); }, 700);
      setTimeout(function () { document.documentElement.classList.add("mo-safe"); }, 2500);
    </script>
    <link rel="modulepreload" href="/assets/moments/moments.js" />
    <link rel="modulepreload" href="/assets/moments/lib.js" />
    <ClientRouter />
  </head>
  <body>
    <slot name="overlay" />
    <SiteHeader isHome={isHome} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter year={year} />
    <script is:inline type="module" src="/assets/moments/moments.js"></script>
  </body>
</html>
