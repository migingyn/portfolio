---
/**
 * Home's autumn scene (DESIGN.md section 5, "Home scene"): two trees, their leaves,
 * and the penguin, who rakes the leaves into a pile and jumps in. Decorative, so it
 * is hidden from assistive tech. What is drawn here is the resting picture (leaves
 * on the trees, the penguin standing); src/scripts/leaf-pile.ts brings it to life
 * unless the visitor prefers reduced motion.
 */
const LEAVES_PER_TREE = 18;

/** Small seeded generator, so every build draws the same trees. */
function seeded(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const random = seeded(2026);
const round = (n: number) => Math.round(n * 10) / 10;

/** Where the trees stand on the wide stage; the script moves them on a phone. */
const TREE_X = [140, 500];
const GROUND = 220;

/** Leaves sit evenly through each crown (a sunflower spiral), relative to the trunk's foot. */
const leaves = [0, 1].flatMap((tree) =>
  Array.from({ length: LEAVES_PER_TREE }, (_, i) => {
    const reach = Math.sqrt((i + 0.5) / LEAVES_PER_TREE);
    const angle = i * 2.39996 + tree * 1.3;
    const dx = round(Math.cos(angle) * reach * 48);
    const dy = round(-130 + Math.sin(angle) * reach * 32);
    return {
      tree,
      dx,
      dy,
      rot: Math.round(random() * 140 - 70),
      scale: round(0.85 + random() * 0.35),
      shade: [1, 0.82, 0.64][Math.floor(random() * 3)],
      x: TREE_X[tree]! + (tree ? -dx : dx),
      y: GROUND + dy,
    };
  }),
);
---

<div class="scene hero-visual" aria-hidden="true">
  <svg class="stage" viewBox="0 0 640 220" focusable="false" data-leaf-pile>
    {
      TREE_X.map((x, i) => (
        <g class="tree" data-tree transform={`translate(${x} ${GROUND})${i ? " scale(-1 1)" : ""}`}>
          <path class="trunk" d="M-5 0C-4.500-34-3.500-66-2.500-98L2.500-98C3.500-66 4.500-34 5 0Z" />
          <path
            class="branches"
            d="M0-92C-8-108-22-116-34-124M0-96C-4-118-10-134-16-150M0-96C6-116 12-132 20-148M0-90C12-104 26-112 38-120M-20-116C-26-124-34-136-40-140M10-128C18-132 30-138 36-144"
          />
        </g>
      ))
    }

    <g data-wind>
      <path class="wind" /><path class="wind" /><path class="wind" /><path class="wind" />
    </g>

    <!-- The penguin, full height: the logo's face and scarf on a whole body. Feet at 0,0. -->
    <g data-penguin transform={`translate(280 ${GROUND})`}>
      <ellipse class="hood" data-foot cx="-8" cy="-2.500" rx="7" ry="3.500" />
      <ellipse class="hood" data-foot cx="8" cy="-2.500" rx="7" ry="3.500" />
      <path class="hood" d="M0-64C16-64 22-48 22-30 22-12 16-2 0-2-16-2-22-12-22-30-22-48-16-64 0-64Z" />
      <path
        class="face"
        d="M1-51C-2-56-14-56-14-45-14-40-12-37-10-34-14-28-15-20-14-13-13-7-7-4 1-4 9-4 15-7 16-13 17-20 16-28 12-34 14-37 16-40 16-45 16-56 4-56 1-51Z"
      />
      <g data-flipper="back"><ellipse class="hood" cx="-21" cy="-28" rx="4.500" ry="13" /></g>
      <g data-flipper="front"><ellipse class="hood" cx="21" cy="-28" rx="4.500" ry="13" /></g>
      <g data-eyes="open">
        <circle class="ink" cx="-4" cy="-45" r="2.500" />
        <circle class="ink" cx="8.500" cy="-45" r="2.500" />
        <circle class="face" cx="-3.200" cy="-45.900" r="0.800" />
        <circle class="face" cx="9.300" cy="-45.900" r="0.800" />
      </g>
      <path data-eyes="happy" class="stroke" display="none" d="M-6.800-44Q-4-48-1.200-44M5.700-44Q8.500-48 11.300-44" />
      <path data-eyes="closed" class="stroke" display="none" d="M-6.800-45.500Q-4-43-1.200-45.500M5.700-45.500Q8.500-43 11.300-45.500" />
      <g data-eyes="sad" display="none">
        <circle class="ink" cx="-4" cy="-44.200" r="2.100" />
        <circle class="ink" cx="8.500" cy="-44.200" r="2.100" />
        <path class="stroke" d="M-7.500-47.200-1.500-49.600M12-47.200 6-49.600" />
      </g>
      <ellipse class="ink" data-beak cx="2.300" cy="-40.600" rx="3.700" ry="2" />
      <path class="leaf" d="M7-31.500 12.500-32.500 14.500-19.500 9-18.500Z" />
      <path class="leaf" d="M-14.800-37C-5-33 9-33 17-37L18-31.300C9-27.300-6-27.300-15.800-31.300Z" />
      <path class="scarf-line" d="M-8.500-34.600-9.300-29M-1.500-33.400-1.800-27.900M6-33.500 6.300-28M12.500-35.200 13.500-29.800" />
    </g>

    <g data-leaves>
      {
        leaves.map((leaf) => (
          <path
            class="leaf"
            d="M-5.500 0C-3-4.200 2.500-4.200 6 0 2.500 4.200-3 4.200-5.500 0Z"
            fill-opacity={leaf.shade}
            data-tree-index={leaf.tree}
            data-dx={leaf.dx}
            data-dy={leaf.dy}
            data-rot={leaf.rot}
            data-scale={leaf.scale}
            transform={`translate(${round(leaf.x)} ${round(leaf.y)}) rotate(${leaf.rot}) scale(${leaf.scale})`}
          />
        ))
      }
    </g>

    <g data-zzz>
      <text class="zzz">z</text><text class="zzz">z</text><text class="zzz">z</text>
    </g>
  </svg>
</div>

<style>
  /* The scene is the visual column of Home's split (BaseLayout). Its stage stands at
     the foot of the column, on the ground hairline; the room above is where the
     leaves fly. */
  .scene {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    pointer-events: none;
  }
  .stage {
    display: block;
    width: 100%;
    max-width: 600px;
    height: auto;
    /* Leaves fly higher than the trees when the pile bursts. */
    overflow: visible;
  }

  @media (min-width: 64rem) {
    .stage {
      max-width: none;
    }
  }

  .trunk {
    fill: var(--color-line);
  }
  .branches {
    fill: none;
    stroke: var(--color-line);
    stroke-width: 2.600;
    stroke-linecap: round;
  }
  .leaf {
    fill: var(--color-accent);
  }
  /* The penguin keeps the logo's three colours in both themes. */
  .hood {
    fill: #2a2a2a;
  }
  .face {
    fill: #f2f0ea;
  }
  .ink {
    fill: #0c0c0c;
  }
  .stroke {
    fill: none;
    stroke: #0c0c0c;
    stroke-width: 1.500;
    stroke-linecap: round;
  }
  .scarf-line {
    fill: none;
    stroke: #0c0c0c;
    stroke-opacity: 0.38;
    stroke-width: 1.600;
  }
  .wind {
    fill: none;
    stroke: var(--color-muted);
    stroke-width: 1;
    stroke-linecap: round;
    opacity: 0;
  }
  .zzz {
    fill: var(--color-muted);
    font-family: var(--font-text);
    font-size: 8px;
    font-weight: 500;
    opacity: 0;
  }
</style>

<script>
  import { mountLeafPile } from "../../scripts/leaf-pile";

  let stop: (() => void) | undefined;

  document.addEventListener("astro:page-load", () => {
    stop?.();
    const stage = document.querySelector<SVGSVGElement>("[data-leaf-pile]");
    stop = stage ? mountLeafPile(stage) : undefined;
  });
  document.addEventListener("astro:before-swap", () => {
    stop?.();
    stop = undefined;
  });
</script>
