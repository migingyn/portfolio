---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import mastheadFont from "@fontsource/grenze-gotisch/files/grenze-gotisch-latin-900-normal.woff2?url";
import bodyFont from "@fontsource/zen-maru-gothic/files/zen-maru-gothic-latin-500-normal.woff2?url";
import SiteMenu from "../components/SiteMenu";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../site.config";
import { getCurrentSeason, seasonStyle } from "../lib/seasons";

interface Props {
  title?: string;
  description?: string;
  /** Home renders the wordmark as the page's h1. */
  isHome?: boolean;
}

const { title, description = site.description, isHome = false } = Astro.props;
const season = await getCurrentSeason();
const pageTitle = title ? `${title} / ${site.name}` : `${site.name} / ${site.tagline}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" style={seasonStyle(season)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101114" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={mastheadFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />
    <script is:inline>
      // Restore the "Pause motion" choice before first paint.
      try {
        if (localStorage.getItem("mn:motion") === "paused") document.documentElement.dataset.motion = "paused";
      } catch (e) {}
    </script>
    <ClientRouter />
  </head>
  <body>
    <a
      href="#main"
      class="type-label sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-paper focus:px-4 focus:py-3 focus:text-ink"
    >
      Skip to content
    </a>
    <slot name="overlay" />
    <div class="grain" aria-hidden="true"></div>
    <div id="shell" class="relative isolate flex min-h-svh flex-col">
      <slot name="backdrop" />
      <SiteMenu
        client:load
        name={site.name}
        tagline={site.tagline}
        items={site.nav}
        currentPath={Astro.url.pathname}
        isHome={isHome}
        hallmark={`${season.data.name} / ${site.city}`}
      />
      <div id="page" class="flex flex-1 flex-col">
        <main id="main" class="flex flex-1 flex-col">
          <slot />
        </main>
        <SiteFooter year={year} />
      </div>
    </div>
  </body>
</html>
