---
/** "Now" card: a small spec sheet with one live LCD readout (local time). */
import LcdScreen from "../ui/LcdScreen.astro";
import { site } from "../../site.config";
---

<aside aria-labelledby="now-heading" class="w-full sm:max-w-[23.5rem]">
  <h2 id="now-heading" class="chrome type-techno-sm inline-block px-3 py-2 text-indigo">Now</h2>
  <dl class="border border-hairline bg-carbon-2">
    <div class="border-b border-hairline p-3">
      <dt class="type-label text-silver-500">Building</dt>
      <dd class="type-body-sm mt-1">{site.now.building}</dd>
    </div>
    <div class="border-b border-hairline p-3">
      <dt class="type-label text-silver-500">Filming</dt>
      <dd class="type-body-sm mt-1">{site.now.filming}</dd>
    </div>
    <div class="flex items-center justify-between gap-3 p-3">
      <dt class="type-label text-silver-500">{site.city} time</dt>
      <dd>
        <LcdScreen>
          <time data-clock data-time-zone={site.timeZone}>--:--:--</time>
        </LcdScreen>
      </dd>
    </div>
  </dl>
</aside>

<script>
  let timer = 0;

  function startClocks() {
    window.clearInterval(timer);
    const clocks = document.querySelectorAll<HTMLTimeElement>("time[data-clock]");
    if (!clocks.length) return;

    const tick = () => {
      const now = new Date();
      for (const clock of clocks) {
        const format = new Intl.DateTimeFormat("en-US", {
          timeZone: clock.dataset.timeZone,
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit",
          hourCycle: "h23",
          timeZoneName: "short",
        });
        clock.textContent = format.format(now);
        clock.dateTime = now.toISOString();
      }
    };
    tick();
    timer = window.setInterval(tick, 1000);
  }

  document.addEventListener("astro:page-load", startClocks);
  document.addEventListener("astro:before-swap", () => window.clearInterval(timer));
</script>
