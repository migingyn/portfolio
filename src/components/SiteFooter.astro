---
/**
 * The page's last screen: a plain index of the site's sections, the one
 * action, and the copyright line.
 */
import { site } from "../site.config";

interface Props {
  year: number;
}
const { year } = Astro.props;
---

<footer class="footer closing" id="index" aria-labelledby="index-h">
  <div class="wrap">
    <div class="closing__cta">
      <div class="closing__index">
      <h2 id="index-h" class="type-title">Site index</h2>
      <ul class="index type-caps">
        {
          site.nav.map((item) => (
            <li>
              {item.ready ? (
                <a href={item.href} class="link">
                  <span>{item.label}</span>
                </a>
              ) : (
                <span class="soon">
                  {item.label} <span class="type-mono">soon</span>
                </span>
              )}
            </li>
          ))
        }
      </ul>
      <a href={site.primaryAction.href} class="btn" rel="me noopener">{site.primaryAction.label}</a>
      </div>
      <p class="closing__name type-wordmark" aria-hidden="true">{site.name}</p>
    </div>
    <div class="closing__links">
      <p class="type-caps">&copy; {year} {site.name}, {site.city}</p>
    </div>
  </div>
</footer>

<style>
  .closing {
    display: flex;
    min-height: 100svh;
    border-top: 1px solid var(--color-line);
  }
  .closing .wrap {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
    padding-block: 96px 72px;
  }
  .closing__cta {
    display: grid;
    gap: 48px;
  }
  .closing__index {
    display: grid;
    justify-items: start;
    gap: 24px;
  }
  /* The name again, set large: the page's one piece of big type. */
  .closing__name {
    font-size: clamp(3.5rem, 11vw, 9.5rem);
    line-height: 0.9;
  }
  .index {
    display: grid;
    width: min(100%, 22.5rem);
  }
  .index li {
    border-bottom: 1px solid var(--color-line);
  }
  .index .soon {
    display: flex;
    min-height: 44px;
    align-items: center;
    gap: 12px;
    color: var(--color-grey);
  }
  .index .type-mono {
    letter-spacing: 0;
    text-transform: none;
  }
  .closing__links {
    color: var(--color-grey);
  }
  @media (min-width: 64rem) {
    .closing {
      height: 100svh;
    }
    /* A 12-column split: the index takes five columns, the name starts on the sixth. */
    .closing__cta {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
      gap: 24px;
    }
    .closing__index {
      grid-column: 1 / span 5;
    }
    .closing__name {
      grid-column: 6 / -1;
    }
  }
</style>
