---
/**
 * The home page's full-screen photograph with the site's vintage treatment:
 * faded colour, soft bloom, vignette, dust. The treatment is all CSS, so any
 * photo dropped into a season file picks it up. Fixed behind the page.
 */
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import dust from "../../assets/dust.webp";

interface Props {
  src: ImageMetadata;
  alt: string;
}
const { src, alt } = Astro.props;

// A tiny copy, stretched and blurred, stands in for lens bloom.
const bloom = await getImage({ src, width: 96, format: "webp", quality: 60 });
const dustTile = await getImage({ src: dust, width: 1200, format: "webp" });
---

<div class="photo" data-photo>
  <Image
    src={src}
    alt={alt}
    widths={[640, 1024, 1600, 2400]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="frame"
  />
  <div class="bloom" style={`background-image:url(${bloom.src})`} aria-hidden="true"></div>
  <div class="wash" aria-hidden="true"></div>
  <div class="dust" style={`background-image:url(${dustTile.src})`} aria-hidden="true"></div>
</div>

<style>
  .photo {
    position: fixed;
    inset: 0;
    z-index: -10;
    overflow: hidden;
    background: var(--color-carbon);
  }
  .frame {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Faded print: lifted blacks, less colour, a warm cast. */
    filter: saturate(0.82) contrast(0.92) sepia(0.14) brightness(0.94);
  }
  .bloom {
    position: absolute;
    inset: -4%;
    background-size: cover;
    background-position: center;
    filter: blur(28px);
    mix-blend-mode: screen;
    opacity: 0.32;
  }
  /* Darken the top and bottom so type holds, and close the corners in. */
  .wash {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(16 17 20 / 0.72) 0%, rgb(16 17 20 / 0) 34%, rgb(16 17 20 / 0) 48%, rgb(16 17 20 / 0.86) 100%),
      radial-gradient(ellipse at center, rgb(16 17 20 / 0) 55%, rgb(16 17 20 / 0.55) 100%);
  }
  .dust {
    position: absolute;
    inset: 0;
    background-size: 1200px 1200px;
    mix-blend-mode: screen;
    opacity: 0.3;
  }

  /* The one authored moment: the photo develops as the loading screen lifts. */
  @media (prefers-reduced-motion: no-preference) {
    .frame {
      animation: develop var(--duration-develop) var(--ease-out) both;
    }
    :global(html[data-loading]) .frame {
      animation-play-state: paused;
    }
    :global(html[data-motion="paused"]) .frame {
      animation: none;
    }
  }
  @keyframes develop {
    from {
      filter: saturate(0) contrast(0.6) sepia(0.14) brightness(2.4) blur(18px);
      scale: 1.06;
    }
  }
</style>
