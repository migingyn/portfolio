---
/** Projects: one row per file in src/content/projects, linking to its write-up. */
import { getCollection } from "astro:content";
import PlaceholderNote from "./PlaceholderNote.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);
---

<ul class="rows">
  {
    projects.map((project) => (
      <li class="row">
        <a href={`/projects/${project.id}`} class="link">
          <span>{project.data.title}</span>
        </a>
        <p class="type-body">{project.data.summary}</p>
        <p class="type-small row__meta">
          {[project.data.year, ...project.data.stack].join(" / ")}
          {project.data.placeholder && <PlaceholderNote />}
        </p>
      </li>
    ))
  }
</ul>
