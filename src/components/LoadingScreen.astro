---
/**
 * First-visit loading screen: the only place ASCII art appears. Plays once per
 * browser (localStorage), can be skipped with the button, Escape, Enter, or a
 * click, and never plays under prefers-reduced-motion. Add ?intro to the URL to
 * replay it.
 */
import type { Season } from "../lib/seasons";
import { site } from "../site.config";

interface Props {
  season: Season;
}
const { season } = Astro.props;
---

<div
  id="loading"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Loading"
  data-style={season.data.ascii}
  class="loading"
>
  <p class="sr-only">{site.name}. Loading issue {season.number}, {season.data.name}.</p>
  <canvas aria-hidden="true"></canvas>
  <div class="foot">
    <p class="status type-pixel" aria-hidden="true">
      <span lang="ja">ロード中</span> NOW LOADING <span class="bar"><i></i></span>
    </p>
    <button type="button" class="btn-gel" data-loading-skip>Skip <span lang="ja">スキップ</span></button>
  </div>
</div>

<script is:inline>
  // Runs before first paint so a first-time visitor never sees the page flash under the loader.
  (function () {
    try {
      var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var replay = new URLSearchParams(location.search).has("intro");
      if (!reduced && (replay || !localStorage.getItem("mn:intro-seen"))) {
        document.getElementById("loading").hidden = false;
        document.documentElement.dataset.loading = "";
      }
    } catch (e) {}
  })();
</script>

<script>
  import { mountAsciiPose, type AsciiStyle } from "../scripts/ascii-pose";

  const SEEN_KEY = "mn:intro-seen";
  const DURATION = 3;

  function play() {
    const loading = document.getElementById("loading");
    const root = document.documentElement;
    if (!loading) {
      delete root.dataset.loading;
      return;
    }

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const replay = new URLSearchParams(location.search).has("intro");
    let seen = true;
    try {
      seen = localStorage.getItem(SEEN_KEY) !== null;
    } catch {}
    if (reduced || (seen && !replay)) {
      loading.hidden = true;
      delete root.dataset.loading;
      return;
    }

    loading.hidden = false;
    root.dataset.loading = "";
    try {
      localStorage.setItem(SEEN_KEY, "1");
    } catch {}

    const shell = document.getElementById("shell");
    const skip = loading.querySelector<HTMLButtonElement>("[data-loading-skip]");
    const canvas = loading.querySelector("canvas")!;
    loading.style.setProperty("--loading-duration", `${DURATION}s`);
    loading.classList.add("is-playing");
    shell?.setAttribute("inert", "");
    skip?.focus({ preventScroll: true });

    let done = false;
    const dispose = mountAsciiPose(canvas, {
      style: loading.dataset.style as AsciiStyle,
      duration: DURATION,
      onDone: finish,
    });

    function finish() {
      if (done) return;
      done = true;
      document.removeEventListener("keydown", onKeyDown);
      shell?.removeAttribute("inert");
      loading!.classList.add("is-leaving");
      delete root.dataset.loading;
      window.setTimeout(() => {
        dispose();
        loading!.hidden = true;
        loading!.classList.remove("is-leaving", "is-playing");
      }, 520);
    }

    function onKeyDown(event: KeyboardEvent) {
      if (event.key === "Escape" || event.key === "Enter") {
        event.preventDefault();
        finish();
      }
    }

    document.addEventListener("keydown", onKeyDown);
    loading.addEventListener("click", finish, { once: true });
  }

  document.addEventListener("astro:page-load", play);
</script>

<style>
  .loading {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    background: var(--color-carbon);
    transition: translate 480ms var(--ease-out);
  }
  .loading[hidden] {
    display: none;
  }
  .loading.is-leaving {
    translate: 0 -100%;
  }
  canvas {
    display: block;
    width: 100%;
    min-height: 0;
    flex: 1;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px var(--page-x) 20px;
  }
  .status {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-silver-50);
  }
  .bar {
    display: inline-block;
    width: 120px;
    height: 12px;
    padding: 2px;
    border: 2px solid var(--color-silver-50);
  }
  .bar i {
    display: block;
    width: 100%;
    height: 100%;
    scale: 0 1;
    transform-origin: left;
    background: var(--color-accent);
  }
  .is-playing .bar i {
    animation: fill var(--loading-duration, 3s) steps(12) forwards;
  }
  @keyframes fill {
    to {
      scale: 1 1;
    }
  }
</style>
