---
/** Full-screen seasonal ASCII visual. Decorative; the hero carries the text alternative. */
import type { Season } from "../../lib/seasons";

interface Props {
  season: Season;
}
const { season } = Astro.props;
---

<canvas
  class="block h-full w-full"
  data-ascii-field
  data-style={season.data.ascii}
  data-glyph={season.data.nameJa}></canvas>

<script>
  import { mountAsciiField, type AsciiStyle } from "../../scripts/ascii-field";

  let dispose: (() => void) | undefined;

  document.addEventListener("astro:page-load", () => {
    dispose?.();
    const canvas = document.querySelector<HTMLCanvasElement>("canvas[data-ascii-field]");
    dispose = canvas
      ? mountAsciiField(canvas, {
          style: canvas.dataset.style as AsciiStyle,
          glyph: canvas.dataset.glyph,
          stage: document.querySelector("[data-ascii-stage]"),
        })
      : undefined;
  });

  document.addEventListener("astro:before-swap", () => {
    dispose?.();
    dispose = undefined;
  });
</script>
