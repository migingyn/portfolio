---
/**
 * The loading screen (DESIGN.md section 5): on a first visit, a black screen with
 * the ASCII character small and centred, cycling through its pose frames. About
 * 2 seconds, skippable with a click or any key, replayable with ?intro. When it
 * ends, the screen and the character fade out together and the page is there.
 * The inline script in BaseLayout decides whether it plays (html[data-intro]).
 */
---

<div class="intro" aria-hidden="true">
  <canvas id="character" width="120" height="120"></canvas>
</div>

<style is:global>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: none;
    place-items: center;
    background: var(--color-canvas);
    transition: opacity var(--duration-base) var(--ease-out);
  }
  .intro canvas {
    width: 120px;
    height: 120px;
  }
  html[data-intro] .intro {
    display: grid;
  }
  /* Leaving: the screen and the character fade out as one. */
  html[data-intro="leaving"] .intro {
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  const SEEN_KEY = "mn:intro-seen";
  const root = document.documentElement;

  async function playIntro() {
    const canvas = document.querySelector<HTMLCanvasElement>("#character");
    if (!canvas) return;
    const under = [...document.querySelectorAll<HTMLElement>("body > header, main")];
    let done = false;

    try {
      localStorage.setItem(SEEN_KEY, "1");
    } catch {}
    under.forEach((el) => el.setAttribute("inert", ""));

    // Only a first visit needs the character's code, so it loads here, not with every page.
    const { mountCharacter } = await import("../scripts/ascii-character");
    const character = mountCharacter(canvas);

    const finish = () => {
      if (done) return;
      done = true;
      document.removeEventListener("keydown", finish);
      document.removeEventListener("pointerdown", finish);
      under.forEach((el) => el.removeAttribute("inert"));
      root.dataset.intro = "leaving";
      window.setTimeout(() => {
        delete root.dataset.intro;
        character.destroy();
      }, 260);
    };

    document.addEventListener("keydown", finish);
    document.addEventListener("pointerdown", finish);
    character.intro(finish);
  }

  // The intro belongs to the first page of a visit only.
  document.addEventListener(
    "astro:page-load",
    () => {
      if (root.dataset.intro === "playing") playIntro();
    },
    { once: true },
  );

  // A page change during the fade must not carry the screen over.
  document.addEventListener("astro:after-swap", () => delete root.dataset.intro);
</script>
