---
/**
 * Every section other than Home. For now each is one screen with its title and
 * one honest line; the real content replaces this file section by section.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site.config";

export function getStaticPaths() {
  return site.sections
    .filter((section) => section.id !== "home")
    .map((section) => ({ params: { section: section.id }, props: { section } }));
}

const { section } = Astro.props;
---

<BaseLayout section={section.id} title={section.label} description={`${section.label}: ${site.description}`}>
  <h1 class="type-title">{section.label}</h1>
  <p class="type-body blurb">{section.blurb}</p>
</BaseLayout>

<style>
  .blurb {
    color: var(--color-muted);
  }
</style>
