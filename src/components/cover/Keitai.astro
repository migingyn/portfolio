---
/**
 * The cover star: a flip phone drawn in CSS. Its LCD is a slot for real content
 * (the "Now" readout). Everything else is decoration and hidden from assistive tech.
 * Sized by --keitai-w on the parent; every measurement scales from it.
 * Round parts (dial, light, mic) are true circles; nothing here is a pill.
 */
const keys = [
  ["1", ""], ["2", "abc"], ["3", "def"],
  ["4", "ghi"], ["5", "jkl"], ["6", "mno"],
  ["7", "pqrs"], ["8", "tuv"], ["9", "wxyz"],
  ["*", ""], ["0", "+"], ["#", ""],
];
---

<div class="keitai">
  <div class="body">
    <span class="antenna" aria-hidden="true"><i class="led"></i></span>

    <div class="lid">
      <span class="speaker" aria-hidden="true"></span>
      <div class="bezel">
        <div class="screen type-pixel">
          <slot />
        </div>
      </div>
      <span class="model" aria-hidden="true">MN-01</span>
    </div>

    <span class="hinge" aria-hidden="true"></span>

    <div class="base" aria-hidden="true">
      <div class="controls">
        <i class="soft"></i>
        <i class="dpad"><b></b></i>
        <i class="soft"></i>
      </div>
      <div class="keys">
        {keys.map(([digit, letters]) => (
          <span class="key">
            <b>{digit}</b>
            {letters && <small>{letters}</small>}
          </span>
        ))}
      </div>
      <span class="mic"></span>
    </div>

    <div class="strap" aria-hidden="true">
      <span class="cord"></span>
      <span class="charm"><slot name="charm" /></span>
    </div>
  </div>
</div>

<style>
  .keitai {
    --u: calc(var(--keitai-w, 240px) / 100);
    position: relative;
    width: calc(var(--u) * 100);
  }
  .body {
    position: relative;
    rotate: -5deg;
    filter: drop-shadow(var(--shadow-product));
  }

  .antenna {
    position: absolute;
    right: calc(var(--u) * 14);
    top: calc(var(--u) * -9);
    width: calc(var(--u) * 7);
    height: calc(var(--u) * 14);
    border: 2px solid var(--color-ink);
    border-radius: calc(var(--u) * 2) calc(var(--u) * 2) 0 0;
    background: var(--gradient-chrome);
  }
  .led {
    position: absolute;
    inset: calc(var(--u) * 1.5) calc(var(--u) * 1.2) auto;
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    background: var(--color-magenta);
  }

  .lid,
  .base {
    position: relative;
    border: 2px solid var(--color-ink);
    background: var(--gradient-chrome);
    box-shadow:
      inset 0 2px 0 var(--color-paper),
      inset 0 -3px 0 var(--color-silver-500);
  }
  .lid {
    padding: calc(var(--u) * 9) calc(var(--u) * 7) calc(var(--u) * 6);
    border-radius: calc(var(--u) * 16) calc(var(--u) * 16) calc(var(--u) * 5) calc(var(--u) * 5);
  }
  .speaker {
    position: absolute;
    left: 50%;
    top: calc(var(--u) * 3.6);
    width: calc(var(--u) * 16);
    height: calc(var(--u) * 2);
    translate: -50% 0;
    border-radius: var(--radius-xs);
    background: var(--color-carbon-3);
  }
  .bezel {
    padding: calc(var(--u) * 2.5);
    border-radius: calc(var(--u) * 6);
    background: var(--color-carbon);
    box-shadow: inset 0 0 0 2px var(--color-carbon-3);
  }
  .screen {
    position: relative;
    overflow: hidden;
    min-height: calc(var(--u) * 92);
    padding: calc(var(--u) * 3) calc(var(--u) * 4);
    border-radius: calc(var(--u) * 3.5);
    background: var(--color-accent);
    color: var(--color-ink);
    font-size: max(11px, calc(var(--u) * 5.2));
    text-align: left;
  }
  /* LCD pixel grid */
  .screen::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(16 17 20 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(16 17 20 / 0.07) 1px, transparent 1px);
    background-size: 3px 3px;
    pointer-events: none;
  }
  .model {
    display: block;
    margin-top: calc(var(--u) * 2.5);
    color: var(--color-silver-600);
    font-family: var(--font-body);
    font-size: calc(var(--u) * 4);
    font-weight: 900;
    letter-spacing: 0.2em;
    line-height: 1;
    text-align: center;
  }

  .hinge {
    display: block;
    width: 78%;
    height: calc(var(--u) * 7);
    margin: -2px auto;
    border: 2px solid var(--color-ink);
    border-radius: calc(var(--u) * 2);
    background: linear-gradient(180deg, var(--color-silver-400), var(--color-silver-50) 40%, var(--color-silver-500));
    position: relative;
    z-index: 1;
  }

  .base {
    padding: calc(var(--u) * 6) calc(var(--u) * 8) calc(var(--u) * 9);
    border-radius: calc(var(--u) * 5) calc(var(--u) * 5) calc(var(--u) * 18) calc(var(--u) * 18);
  }
  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: calc(var(--u) * 5);
  }
  .soft {
    width: calc(var(--u) * 20);
    height: calc(var(--u) * 8);
    border: 2px solid var(--color-ink);
    border-radius: calc(var(--u) * 2);
    background: var(--color-pink);
    box-shadow: inset 0 2px 0 rgb(255 255 255 / 0.6);
  }
  .dpad {
    display: grid;
    place-items: center;
    width: calc(var(--u) * 26);
    aspect-ratio: 1;
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-full);
    background: var(--color-silver-50);
    box-shadow: inset 0 -3px 0 var(--color-silver-400);
  }
  .dpad b {
    width: 42%;
    aspect-ratio: 1;
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-full);
    background: var(--color-forward);
  }
  .keys {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: calc(var(--u) * 3);
  }
  .key {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: calc(var(--u) * 1);
    padding: calc(var(--u) * 2) 0;
    border: 2px solid var(--color-ink);
    border-radius: calc(var(--u) * 4);
    background: var(--color-silver-50);
    box-shadow: inset 0 -3px 0 var(--color-silver-400);
    color: var(--color-ink);
    font-family: var(--font-body);
    line-height: 1;
  }
  .key b {
    font-size: calc(var(--u) * 6.5);
    font-weight: 900;
  }
  .key small {
    font-size: calc(var(--u) * 3.4);
    font-weight: 700;
  }
  .mic {
    position: absolute;
    left: 50%;
    bottom: calc(var(--u) * 4);
    width: calc(var(--u) * 3);
    aspect-ratio: 1;
    translate: -50% 0;
    border-radius: var(--radius-full);
    background: var(--color-carbon-3);
  }

  .strap {
    position: absolute;
    left: calc(var(--u) * -3);
    top: 49%;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform-origin: 50% 0;
    rotate: 8deg;
  }
  .cord {
    width: 2px;
    height: calc(var(--u) * 26);
    background: var(--color-paper);
  }
  .charm {
    display: block;
    width: calc(var(--u) * 30);
    margin-top: -2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .keitai {
      animation: bob 5s ease-in-out infinite;
    }
    .strap {
      animation: swing 2.6s ease-in-out infinite alternate;
    }
    .led {
      animation: blink 1.6s steps(1) infinite;
    }
  }

  @keyframes bob {
    50% {
      translate: 0 -10px;
    }
  }
  @keyframes swing {
    from {
      rotate: 16deg;
    }
    to {
      rotate: -6deg;
    }
  }
  @keyframes blink {
    50% {
      background: var(--color-carbon-3);
    }
  }
</style>
