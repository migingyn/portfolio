---
/**
 * Magazine cover line: a big title and one line of copy. A link once its page
 * exists; until then it says so in plain text.
 */
import type { CoverLine } from "../../site.config";

interface Props {
  line: CoverLine;
  ready: boolean;
  align?: "left" | "right";
}
const { line, ready, align = "left" } = Astro.props;
const Tag = ready ? "a" : "div";
---

<Tag href={ready ? line.href : undefined} class:list={["line", `align-${align}`, { ready }]}>
  <span class="title type-shout-md">{line.title}</span>
  <span class="copy type-body">{line.copy}</span>
  {!ready && <span class="soon type-label">Coming soon</span>}
</Tag>

<style>
  .line {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    color: var(--color-silver-50);
  }
  .align-right {
    align-items: flex-end;
    text-align: right;
  }
  .title {
    font-size: clamp(2.25rem, 3.8vw, 3rem);
    transition:
      color var(--duration-fast) var(--ease-out),
      translate var(--duration-base) var(--ease-out);
  }
  .copy {
    margin-top: 4px;
    color: var(--color-silver-50);
  }
  .soon {
    margin-top: 2px;
    color: var(--color-silver-400);
  }
  @media (hover: hover) and (pointer: fine) {
    .ready:hover .title {
      color: var(--color-forward);
    }
    .ready.align-left:hover .title {
      translate: 6px 0;
    }
    .ready.align-right:hover .title {
      translate: -6px 0;
    }
  }
</style>
