---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site.config";
---

<BaseLayout section="home">
  <h1 class="type-name">{site.name}</h1>
  <p class="type-body">{site.tagline}</p>
  <ul class="links">
    {
      site.homeLinks.map((link, i) => (
        <li>
          {/* The first is the page's one button; the rest are plain links. */}
          {i === 0 ? (
            <a href={link.href} class="btn">{link.label}</a>
          ) : (
            <a href={link.href} class="link" rel={link.href.startsWith("http") ? "me noopener" : undefined}>
              <span>{link.label}</span>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
  }
</style>
