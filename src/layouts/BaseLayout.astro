---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import textFont from "@fontsource/inter/files/inter-latin-500-normal.woff2?url";
import displayFont from "@fontsource/inter/files/inter-latin-700-normal.woff2?url";
import Character from "../components/Character.astro";
import Dial from "../components/Dial";
import NowPlaying from "../components/NowPlaying";
import { site } from "../site.config";
import { logoMarkup } from "../lib/logo";
import { getCurrentSeason, seasonStyle } from "../lib/seasons";
import { sectionVideo } from "../lib/video";

interface Props {
  /** The section this page is: sets its video and its place on the dial. */
  section: string;
  title?: string;
  description?: string;
}

const { section, title, description = site.description } = Astro.props;
const season = await getCurrentSeason();
const pageTitle = title ? `${title} / ${site.name}` : `${site.name}, backend engineer and creative builder`;
// Home's clip can change with the season.
const video = sectionVideo(section === "home" ? (season.data.video ?? "home") : section);
const { spotifyPlaylistId, tracks } = season.data;
---

<!doctype html>
<html lang="en" data-type="software" style={seasonStyle(season)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="page-type" content="software" />
    <meta name="site-kind" content="software" />
    <meta name="theme-color" content="#0c0c0c" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={textFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
    <script is:inline>
      // The theme, before anything paints: dark unless the visitor chose light.
      (function () {
        var root = document.documentElement;
        var CANVAS = { dark: "#0c0c0c", light: "#f2f0ea" };
        var theme = "dark";
        try {
          if (localStorage.getItem("mn:theme") === "light") theme = "light";
        } catch (e) {}
        root.dataset.theme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.content = CANVAS[theme];
        // A page change brings a fresh <html>: carry the theme (and a fade under way) over.
        document.addEventListener("astro:before-swap", function (event) {
          var next = event.newDocument.documentElement;
          next.dataset.theme = root.dataset.theme || "dark";
          if (root.hasAttribute("data-theme-change")) next.setAttribute("data-theme-change", "");
          var nextMeta = event.newDocument.querySelector('meta[name="theme-color"]');
          if (nextMeta) nextMeta.content = CANVAS[next.dataset.theme];
        });
      })();
      // First visit (or ?intro): show the loading screen before anything paints.
      (function () {
        try {
          var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          var replay = new URLSearchParams(location.search).has("intro");
          if (!reduced && (replay || !localStorage.getItem("mn:intro-seen"))) {
            document.documentElement.dataset.intro = "playing";
          }
        } catch (e) {}
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <header class="nav">
      <div class="wrap">
        <a class="skip link" href="#main"><span>Skip to content</span></a>
        <button type="button" class="logo" data-dial-open aria-haspopup="dialog" aria-expanded="false" aria-label="Open navigation">
          <Fragment set:html={logoMarkup(season.data.outfit)} />
        </button>
        <p class="type-small season">{[season.data.name, season.data.mood].filter(Boolean).join(" / ")}</p>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to light mode">
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.25"></circle>
            <path d="M12 2.75v2M12 19.25v2M2.75 12h2M19.250 12h2M5.460 5.460l1.410 1.410M17.130 17.130l1.410 1.410M5.460 18.540l1.410-1.410M17.130 6.870l1.410-1.410"></path>
          </svg>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 14.500A8.750 8.750 0 1 1 9.500 4a7.500 7.500 0 0 0 10.500 10.500Z"></path>
          </svg>
        </button>
        <Character />
      </div>
    </header>

    <main id="main">
      <!-- One full screen: the section's muted loop behind, small text along the left edge. -->
      <section class:list={["section", { "has-video": video.src }]}>
        {
          video.src ? (
            <video class="layer" muted loop playsinline preload="metadata" poster={video.poster} aria-hidden="true" data-section-video>
              <source src={video.src} type="video/mp4" />
            </video>
          ) : (
            <img class="layer" src="/video/placeholder.svg" alt="" aria-hidden="true" />
          )
        }
        <div class="wrap">
          <div class="hero-text">
            <slot />
            {
              video.src && (
                <button type="button" class="link pause" data-video-toggle aria-pressed="false" hidden>
                  <span>Pause video</span>
                </button>
              )
            }
          </div>
        </div>
      </section>
    </main>

    {
      spotifyPlaylistId && tracks.length > 0 && (
        <NowPlaying
          client:idle
          transition:persist="now-playing"
          seasonName={season.data.name}
          playlistId={spotifyPlaylistId}
          tracks={tracks}
        />
      )
    }
    <Dial client:load items={site.sections.map(({ label, href }) => ({ label, href }))} currentPath={Astro.url.pathname} />

    <script>
      // Section loops play unless the visitor prefers reduced motion; then the poster stands.
      // A loop that never stops gets an off switch.
      function startVideo() {
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const video = document.querySelector<HTMLVideoElement>("video[data-section-video]");
        const toggle = document.querySelector<HTMLButtonElement>("[data-video-toggle]");
        if (!video || reduced) return;

        video.play().catch(() => {});
        if (!toggle) return;
        const label = toggle.querySelector("span")!;
        toggle.hidden = false;
        toggle.onclick = () => {
          const paused = !video.paused;
          if (paused) video.pause();
          else video.play().catch(() => {});
          toggle.setAttribute("aria-pressed", String(paused));
          label.textContent = paused ? "Play video" : "Pause video";
        };
      }

      document.addEventListener("astro:page-load", startVideo);

      // Theme switch. The icon changes at once; the colours hold, then fade slowly (global.css).
      const root = document.documentElement;
      const CANVAS = { dark: "#0c0c0c", light: "#f2f0ea" } as const;
      let fadeTimer = 0;

      // A CSS time in milliseconds, whether the build wrote it as "1200ms" or "1.2s".
      const ms = (name: string) => {
        const value = getComputedStyle(root).getPropertyValue(name).trim();
        return (parseFloat(value) || 0) * (value.endsWith("ms") ? 1 : 1000);
      };
      const currentTheme = () => (root.dataset.theme === "light" ? "light" : "dark");

      function labelToggle() {
        const next = currentTheme() === "light" ? "dark" : "light";
        document.querySelector("[data-theme-toggle]")?.setAttribute("aria-label", `Switch to ${next} mode`);
      }

      function setTheme(theme: "dark" | "light") {
        const length = ms("--delay-theme") + ms("--duration-theme");
        root.dataset.themeChange = "";
        root.dataset.theme = theme;
        try {
          localStorage.setItem("mn:theme", theme);
        } catch {}
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", CANVAS[theme]);
        labelToggle();
        // The ASCII character is drawn, not styled: it follows the fade frame by frame.
        window.dispatchEvent(new CustomEvent("theme:change", { detail: { length } }));
        window.clearTimeout(fadeTimer);
        fadeTimer = window.setTimeout(() => delete root.dataset.themeChange, length + 50);
      }

      document.addEventListener("click", (event) => {
        if (!(event.target as Element).closest("[data-theme-toggle]")) return;
        setTheme(currentTheme() === "light" ? "dark" : "light");
      });
      document.addEventListener("astro:page-load", labelToggle);
    </script>
  </body>
</html>

<style>
  /* One container for the header and every section: equal margins, nothing else. */
  .wrap {
    width: calc(100% - 2 * var(--margin));
    margin-inline: auto;
  }

  .skip {
    position: fixed;
    left: var(--margin);
    top: 8px;
    z-index: 70;
    padding: 0 16px;
    background: var(--color-text);
    color: var(--color-canvas);
  }
  .skip:not(:focus) {
    clip-path: inset(50%);
    width: 1px;
    min-width: 0;
    height: 1px;
    min-height: 0;
    overflow: hidden;
    padding: 0;
  }

  /* The logo, a penguin in the season's outfit, sits in the top-left corner and opens the dial. */
  .logo {
    position: fixed;
    left: var(--margin);
    top: calc(var(--margin) - 8px);
    z-index: 50;
    display: block;
    width: 48px;
    height: 48px;
    transition: scale var(--duration-fast) var(--ease-out);
  }
  .logo :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .logo:active {
    scale: 0.94;
  }

  /* The season, small, in the top-right corner. */
  .season {
    position: fixed;
    /* Left of the theme switch. */
    right: calc(var(--margin) + 44px);
    top: var(--margin);
    z-index: 30;
    max-width: 16rem;
    color: var(--color-muted);
    text-align: right;
  }

  /* Each section is one full screen with its video behind it. Text sits small
     along the left edge, never centred in a box. */
  .section {
    position: relative;
    display: flex;
    min-height: max(100svh, 32rem);
    align-items: center;
    /* Clear the logo above and the corner character below when a list runs long. */
    padding-block: calc(var(--margin) + 72px) calc(var(--margin) + 104px);
  }
  .layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  img.layer {
    object-fit: fill;
  }
  /* A soft scrim of the canvas colour at the edges, so small text over footage keeps its
     contrast in either theme. */
  .has-video::before {
    --scrim-strong: color-mix(in srgb, var(--color-canvas) 82%, transparent);
    --scrim: color-mix(in srgb, var(--color-canvas) 70%, transparent);
    --scrim-none: color-mix(in srgb, var(--color-canvas) 0%, transparent);
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, var(--scrim-strong), var(--scrim-none) 55%),
      linear-gradient(0deg, var(--scrim), var(--scrim-none) 30%),
      linear-gradient(180deg, var(--scrim), var(--scrim-none) 25%);
    pointer-events: none;
  }
  .section .wrap {
    position: relative;
    z-index: 2;
  }
  .hero-text {
    display: grid;
    justify-items: start;
    gap: 16px;
    max-width: 36rem;
  }
  .pause {
    color: var(--color-muted);
  }
</style>
