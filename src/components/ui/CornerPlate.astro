---
/**
 * Corner plate (DESIGN.md section 6): chrome plate pinned to a tile corner,
 * inner corner chamfered. At most two per tile, on opposite corners.
 */
interface Props {
  corner: "top-left" | "bottom-right";
  class?: string;
}
const { corner, class: className } = Astro.props;
const chamfer = corner === "top-left" ? "chamfer-br" : "chamfer-tl";
---

<p class:list={["chrome type-techno-sm w-fit px-3 py-2 text-indigo", chamfer, className]}>
  <slot />
</p>
