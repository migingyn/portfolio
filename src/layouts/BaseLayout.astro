---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import jpFontsHref from "../styles/fonts-jp.css?url";
import wordmarkFont from "@fontsource/manufacturing-consent/files/manufacturing-consent-latin-400-normal.woff2?url";
import bodyFont from "@fontsource/zen-kaku-gothic-new/files/zen-kaku-gothic-new-latin-400-normal.woff2?url";
import SiteMenu from "../components/SiteMenu";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../site.config";
import { getCurrentSeason, seasonStyle } from "../lib/seasons";

interface Props {
  title?: string;
  description?: string;
  /** Home renders the wordmark as the page's h1. */
  isHome?: boolean;
}

const { title, description = site.description, isHome = false } = Astro.props;
const season = await getCurrentSeason();
const pageTitle = title ? `${title} / ${site.name}` : `${site.name} / ${site.tagline}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" style={seasonStyle(season)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101114" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={wordmarkFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />
    <link id="fonts-jp" rel="stylesheet" href={jpFontsHref} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={jpFontsHref} /></noscript>
    <ClientRouter />
  </head>
  <body>
    <a
      href="#main"
      class="type-label sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-carbon focus:px-4 focus:py-3 focus:text-silver-50"
    >
      Skip to content
    </a>
    <slot name="overlay" />
    <div id="shell" class="relative isolate flex min-h-svh flex-col">
      <div class="absolute inset-0 -z-10" aria-hidden="true">
        <slot name="backdrop" />
      </div>
      <SiteMenu
        client:load
        name={site.name}
        tagline={site.tagline}
        items={site.nav}
        currentPath={Astro.url.pathname}
        isHome={isHome}
        hallmark={`${season.data.name} / ${site.city}`}
      />
      <div id="page" class="flex flex-1 flex-col">
        <main id="main" class="flex flex-1 flex-col">
          <slot />
        </main>
        <SiteFooter year={year} />
      </div>
    </div>
  </body>
</html>
