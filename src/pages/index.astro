---
import BaseLayout from "../layouts/BaseLayout.astro";
import LoadingScreen from "../components/LoadingScreen.astro";
import Keitai from "../components/cover/Keitai.astro";
import NowScreen from "../components/cover/NowScreen.astro";
import SeasonCharm from "../components/cover/SeasonCharm.astro";
import Starburst from "../components/cover/Starburst.astro";
import CoverLine from "../components/cover/CoverLine.astro";
import Ticker from "../components/cover/Ticker.astro";
import { site } from "../site.config";
import { formatSeasonDate, getCurrentSeason } from "../lib/seasons";

const season = await getCurrentSeason();
const { name, headline, mood, start, end, ascii } = season.data;

const isReady = (href: string) => site.nav.some((item) => item.href === href && item.ready);
const [firstLine, ...otherLines] = site.coverLines;
const issue = `Vol.${season.number}`;
const ticker = [
  `${issue} ${name}`,
  site.tagline.replace(/\.$/, ""),
  `Now building: ${site.now.building.replace(/\.$/, "")}`,
  `${site.city}, California`,
  "Tap the name for the menu",
];
---

<BaseLayout isHome>
  <LoadingScreen slot="overlay" season={season} />

  <section aria-labelledby="issue-name" class="cover">
    <div class="issue enter" style="--i:1">
      <span class="stamp type-label">First issue</span>
      <p class="type-label">
        <span id="issue-name">{issue} / {name}</span>
        <span class="dates">
          <time datetime={start.toISOString().slice(0, 10)}>{formatSeasonDate(start)}</time>
          {" to "}
          <time datetime={end.toISOString().slice(0, 10)}>{formatSeasonDate(end)}</time>
        </span>
      </p>
    </div>

    {
      headline.length > 0 && (
        <p class="headline ink-outline enter" style="--i:3">
          {headline.map((part) => <span>{part}</span>)}
        </p>
      )
    }

    <div class="star">
      <div class="disc enter" style="--i:0" aria-hidden="true"></div>
      <div class="phone enter" style="--i:2">
        <Keitai>
          <NowScreen />
          <SeasonCharm slot="charm" motif={ascii} />
        </Keitai>
      </div>
      <Starburst class="new enter" style="--i:5">
        <span class="type-shout-sm">New!</span><br />
        <span class="type-label">Season {season.number}</span>
      </Starburst>
      <p class="bubble type-hand enter" style="--i:6">{mood}</p>
    </div>

    <ul class="lines lines-left">
      {
        firstLine && (
          <li class="enter" style="--i:4">
            <CoverLine line={firstLine} ready={isReady(firstLine.href)} />
          </li>
        )
      }
    </ul>

    <ul class="lines lines-right">
      {
        otherLines.map((line, i) => (
          <li class="enter" style={`--i:${5 + i}`}>
            <CoverLine line={line} ready={isReady(line.href)} align="right" />
          </li>
        ))
      }
    </ul>

    <div class="price enter" style="--i:7">
      <span class="barcode" aria-hidden="true"></span>
      <p class="type-label">Price: free</p>
    </div>
  </section>

  <Ticker items={ticker} />
</BaseLayout>

<style>
  .cover {
    --keitai-w: clamp(168px, 24.5vh, 232px);
    position: relative;
    display: grid;
    flex: 1;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "issue" "star" "headline" "left" "right" "price";
    gap: 24px;
    align-items: center;
    overflow-x: clip;
    padding: 20px var(--page-x) 32px;
  }

  .issue {
    grid-area: issue;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-silver-50);
  }
  .stamp {
    flex-shrink: 0;
    padding: 5px 8px;
    rotate: -4deg;
    background: var(--color-red);
    color: var(--color-paper);
  }
  .dates {
    display: block;
    color: var(--color-silver-400);
  }

  .headline {
    grid-area: headline;
    z-index: 2;
    margin-top: -72px;
    rotate: -5deg;
    color: var(--color-forward);
    font-family: var(--font-shout);
    font-size: clamp(2.5rem, 11vw, 3.5rem);
    line-height: 1.05;
    -webkit-text-stroke-color: var(--color-paper);
    text-shadow: 0.07em 0.07em 0 var(--color-magenta);
    pointer-events: none;
  }
  .headline span {
    display: block;
  }
  .headline span + span {
    margin-left: 0.5em;
  }

  .star {
    grid-area: star;
    position: relative;
    display: grid;
    place-items: center;
    padding: 28px 0 12px;
  }
  .disc {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--keitai-w) * 2.1);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: var(--radius-full);
    background: var(--gradient-sky);
  }
  /* Screentone ring peeking out from behind the disc. */
  .disc::before {
    content: "";
    position: absolute;
    inset: -9%;
    z-index: -1;
    border-radius: inherit;
    background-image: radial-gradient(var(--color-sky) 2px, transparent 2.5px);
    background-size: 9px 9px;
    mask-image: radial-gradient(closest-side, #000 86%, transparent 100%);
  }
  .phone {
    position: relative;
  }
  .new {
    position: absolute;
    right: 0;
    top: 0;
    width: calc(var(--keitai-w) * 0.52);
    min-width: 104px;
  }
  .bubble {
    position: absolute;
    left: 0;
    bottom: 6%;
    z-index: 2;
    max-width: 11.5rem;
    padding: 10px 14px;
    rotate: -4deg;
    border-radius: var(--radius-md);
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: 1rem;
  }
  .bubble::after {
    content: "";
    position: absolute;
    right: 18px;
    top: -11px;
    width: 18px;
    height: 18px;
    rotate: 45deg;
    background: var(--color-paper);
  }
  .lines {
    display: grid;
    gap: 28px;
  }
  .lines-left { grid-area: left; }
  .lines-right { grid-area: right; }

  .price {
    grid-area: price;
    display: flex;
    flex-direction: column;
    gap: 4px;
    justify-self: end;
    padding: 6px 8px;
    rotate: 3deg;
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .barcode {
    width: 96px;
    height: 34px;
    background: repeating-linear-gradient(
      90deg,
      var(--color-ink) 0 2px,
      transparent 2px 3px,
      var(--color-ink) 3px 4px,
      transparent 4px 7px,
      var(--color-ink) 7px 10px,
      transparent 10px 12px
    );
  }

  /* Tablet and up: a three-column cover with the phone in the middle. */
  @media (min-width: 64rem) {
    .cover {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      grid-template-rows: auto 1fr auto;
      grid-template-areas:
        "issue    star right"
        "headline star right"
        "left     star price";
      column-gap: clamp(72px, 9vw, 150px);
      row-gap: 8px;
      padding-block: 4px 16px;
    }
    .issue { align-self: start; }
    .headline {
      align-self: center;
      margin: 0 -40px 0 0;
      font-size: clamp(2.5rem, min(4.4vw, 9vh), 4.25rem);
    }
    .star {
      align-self: center;
      justify-self: center;
      padding: 36px 0 0;
    }
    .new { right: calc(var(--keitai-w) * -0.62); }
    .bubble { left: calc(var(--keitai-w) * -0.66); }
    .lines-left { align-self: end; }
    .lines-right { align-self: center; }
    .price { align-self: end; }
  }
</style>
